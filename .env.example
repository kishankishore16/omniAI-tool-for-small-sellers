# ══════════════════════════════════════════════════════════════
# OmniAI — Environment Configuration
# Copy this to .env and fill in your values
# ══════════════════════════════════════════════════════════════

# --- Google Gemini API (Optional — free tier at aistudio.google.com) ---
# Leave empty to use offline CV mode (PIL-based feature extraction)
GEMINI_API_KEY=

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
API_BASE_URL=http://localhost:8000

# --- Data Paths (defaults work out of the box) ---
# CHROMA_PERSIST_DIR=./data/chroma_db
# SQLITE_DB_PATH=./data/omniai.db
# UPLOAD_DIR=./data/uploads

# --- Debug Mode ---
DEBUG=false
